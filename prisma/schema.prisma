generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "mysql"
}

model Admin {
  id           String   @id @default(cuid())
  name         String
  email        String   @unique
  passwordHash String
  role         String   @default("admin")
  active       Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@map("admins")
}

model Analytics {
  id        String   @id @default(cuid())
  page      String   @default("")
  path      String   @default("")
  event     String   @default("page_view")
  referrer  String   @default("")
  userAgent String   @default("")
  ip        String   @default("")
  metadata  Json?
  createdAt DateTime @default(now())

  @@map("analytics")
}

model ApplicationCounter {
  id        String   @id @default(cuid())
  name      String   @unique
  sequence  Int      @default(0)
  year      Int
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("applicationcounters")
}

model CareerApplication {
  id                   String    @id @default(cuid())
  applicationId        String    @unique
  jobId                String    @default("")
  jobTitle             String
  department           String    @default("")
  location             String    @default("")
  employmentType       String    @default("")
  fullName             String
  email                String
  phone                String
  dateOfBirth          String    @default("")
  gender               String    @default("")
  address              String
  city                 String    @default("")
  state                String    @default("")
  pincode              String    @default("")
  highestQualification String    @default("")
  university           String    @default("")
  passingYear          String    @default("")
  percentage           String    @default("")
  experience           String    @default("")
  currentOrganization  String    @default("")
  currentDesignation   String    @default("")
  totalExperience      String    @default("")
  resume               String    @default("")
  coverLetter          String    @default("")
  declarationAccepted  Boolean   @default(false)
  status               String    @default("pending")
  stage                String    @default("")
  adminRemarks         String    @default("")
  approvedAt           DateTime?
  rejectedAt           DateTime?
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt

  @@index([email])
  @@index([applicationId])
  @@index([status])
  @@map("careerapplications")
}

model ChildWelfareApplication {
  id                 String    @id @default(cuid())
  applicationId      String    @unique
  guardianName       String
  relation           String
  mobile             String
  email              String    @default("")
  childName          String
  dateOfBirth        String    @default("")
  gender             String
  schoolName         String    @default("")
  educationLevel     String    @default("")
  address            String
  village            String    @default("")
  district           String
  state              String
  pincode            String    @default("")
  supportRequired    Json?
  supportDescription String    @default("")
  familyIncome       String    @default("")
  status             String    @default("submitted")
  adminRemark        String    @default("")
  submittedAt        DateTime  @default(now())
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  @@index([mobile])
  @@index([status])
  @@map("child_welfare_applications")
}

model DivyangApplication {
  id                  String   @id @default(cuid())
  applicationId       String   @unique
  fullName            String
  fatherName          String   @default("")
  dateOfBirth         String
  gender              String   @default("")
  mobile              String
  email               String   @default("")
  disabilityType      String
  disabilityPercentage String  @default("")
  state               String
  district            String
  address             String   @default("")
  pincode             String   @default("")
  status              String   @default("pending")
  source              String   @default("website")
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  @@index([mobile])
  @@index([status])
  @@map("divyangapplications")
}

model DivyangStatusHistory {
  id            String   @id @default(cuid())
  applicationId String
  status        String
  title         String
  message       String?
  updatedBy     String   @default("AJFT SYSTEM")
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([applicationId])
  @@index([status])
  @@index([applicationId, createdAt])
  @@map("divyangstatushistories")
}

model Donation {
  id                String   @id @default(cuid())
  donationReference String   @unique
  donorName         String
  mobile            String
  email             String
  address           String
  city              String   @default("")
  state             String   @default("")
  pinCode           String   @default("")
  country           String   @default("")
  donorType         String   @default("indian")
  donationMode      String   @default("indian")
  donationType      String   @default("one-time")
  requires80G       Boolean  @default(false)
  pan               String   @default("")
  amount            Float
  currency          String   @default("INR")
  razorpayOrderId   String   @default("")
  orderId           String   @default("")
  paymentStatus     String   @default("PENDING")
  paymentId         String   @default("")
  receiptNo         String   @default("")
  sourceAction      String   @default("")
  action            String   @default("")
  buttonId          String   @default("")
  utmSource         String   @default("")
  utmMedium         String   @default("")
  utmCampaign       String   @default("")
  utmContent        String   @default("")
  utmTerm           String   @default("")
  landingPage       String   @default("")
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  @@index([razorpayOrderId])
  @@index([orderId])
  @@index([paymentId])
  @@index([receiptNo])
  @@index([sourceAction])
  @@index([utmSource])
  @@index([utmMedium])
  @@index([utmCampaign])
  @@map("donations")
}

model EnvironmentParticipant {
  id             String   @id @default(cuid())
  participantId  String   @unique
  fullName       String
  email          String   @unique
  mobile         String   @default("")
  password       String
  address        String   @default("")
  district       String   @default("")
  state          String   @default("")
  pincode        String   @default("")
  status         String   @default("active")
  walletBalance  Float    @default(0)
  totalRewards   Float    @default(0)
  totalTrees     Int      @default(0)
  lastLoginAt    DateTime?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@index([email])
  @@map("environmentparticipants")
}

model EnvironmentPayment {
  id                   String   @id @default(cuid())
  paymentId            String   @unique
  participantId        String
  amount               Float
  paymentMethod        String
  upiId                String   @default("")
  accountHolder        String   @default("")
  bankName             String   @default("")
  accountNumber        String   @default("")
  ifscCode             String   @default("")
  status               String   @default("pending")
  transactionReference String   @default("")
  adminRemark          String   @default("")
  paidAt               DateTime?
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt

  @@index([participantId])
  @@index([status])
  @@map("environmentpayments")
}

model EnvironmentPlantation {
  id               String   @id @default(cuid())
  plantationId     String   @unique
  participantId    String
  treeName         String
  treeType         String   @default("")
  quantity         Int      @default(1)
  plantedDate      DateTime @default(now())
  location         String   @default("")
  address          String   @default("")
  district         String   @default("")
  state            String   @default("")
  pincode          String   @default("")
  latitude         String   @default("")
  longitude        String   @default("")
  plantationPhoto  String   @default("")
  additionalPhoto  String   @default("")
  status           String   @default("pending")
  verifiedBy       String   @default("")
  verifiedAt       DateTime?
  rejectionReason  String   @default("")
  rewardEligible   Boolean  @default(false)
  rewardAmount     Float    @default(0)
  rewardStatus     String   @default("not_eligible")
  rewardPaidAt     DateTime?
  adminRemarks     String   @default("")
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  @@index([participantId, createdAt])
  @@index([status, createdAt])
  @@map("environmentplantations")
}

model EnvironmentWallet {
  id              String   @id @default(cuid())
  participantId   String   @unique
  totalEarned     Float    @default(0)
  availableBalance Float   @default(0)
  totalPaid       Float    @default(0)
  transactions    Json?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([participantId])
  @@map("environmentwallets")
}

model HealthHelpRequest {
  id          String   @id @default(cuid())
  requestId   String   @unique
  name        String
  phone       String
  age         Int?
  gender      String   @default("")
  location    String
  helpType    String
  urgency     String   @default("General")
  description String
  status      String   @default("pending")
  adminNote   String   @default("")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([phone])
  @@index([status])
  @@map("healthhelprequests")
}

model InternshipApplication {
  id                     String   @id @default(cuid())
  applicationId          String   @unique

  studentName            String
  studentEmail           String
  studentPhone           String
  studentDob             String   @default("")
  studentAddress         String   @default("")
  studentCity            String   @default("")
  studentState           String   @default("")
  studentPincode         String   @default("")

  educationInstitution   String   @default("")
  educationCourse       String   @default("")
  educationQualification String   @default("")

  internshipArea         String
  internshipDuration     String
  internshipStartDate    String   @default("")
  internshipEndDate      String   @default("")

  status                 String   @default("SUBMITTED")
  physicalReceived       Boolean  @default(false)
  physicalReceivedAt     DateTime?
  approvedAt             DateTime?
  internId               String?
  completedAt            DateTime?
  certificateEligible    Boolean  @default(false)
  certificatePaymentStatus String @default("PENDING")
  certificateId          String?

  createdAt              DateTime @default(now())
  updatedAt              DateTime @updatedAt

  @@index([applicationId])
  @@index([status])
  @@map("internshipapplications")
}

model InternshipIdCard {
  id             String   @id @default(cuid())
  applicationId  String   @unique
  internId       String   @unique
  cardNumber     String   @unique
  studentName    String
  internshipArea String
  duration       String
  startDate      String?
  endDate        String?
  issuedAt       DateTime @default(now())
  status         String   @default("ACTIVE")
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@index([internId])
  @@map("internshipidcards")
}

model News {
  id          String   @id @default(cuid())
  title       String
  slug        String   @unique
  excerpt     String
  content     String   @db.LongText
  category    String   @default("General")
  image       String   @default("")
  author      String   @default("AJFT Team")
  featured    Boolean  @default(false)
  important   Boolean  @default(false)
  status      String   @default("draft")
  publishedAt DateTime?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([status])
  @@index([featured, important, publishedAt, createdAt])
  @@map("news")
}

model PageView {
  id        String   @id @default(cuid())
  visitorId String
  sessionId String
  path      String
  title     String?
  referrer  String?
  viewedAt  DateTime @default(now())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([visitorId])
  @@index([sessionId])
  @@index([path])
  @@index([viewedAt])
  @@map("pageviews")
}

model Project {
  id                 String   @id @default(cuid())
  projectCode        String   @unique
  title              String
  slug               String   @unique
  category           String
  status             String   @default("ongoing")
  shortDescription   String   @default("")
  description        String   @db.LongText
  state              String   @default("Bihar")
  district           String   @default("")
  block              String   @default("")
  village            String   @default("")
  startDate          DateTime?
  endDate            DateTime?
  approvedBudget     Float    @default(0)
  expenditure        Float    @default(0)
  beneficiaries      Int      @default(0)
  targetBeneficiaries Int     @default(0)
  progress           Int      @default(0)
  implementingPartner String  @default("Anand Jivan Foundation Trust")
  fundingSource      String   @default("")
  coverImage         String   @default("")
  gallery            Json?
  achievements       Json?
  objectives         Json?
  challenges         Json?
  reportFile         String   @default("")
  featured           Boolean  @default(false)
  isPublished        Boolean  @default(true)
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  @@index([projectCode])
  @@index([title])
  @@index([slug])
  @@index([category])
  @@index([status])
  @@index([state])
  @@index([district])
  @@index([featured])
  @@index([isPublished])
  @@map("projects")
}

model SkillStudent {
  id           String   @id @default(cuid())
  studentId    String   @unique
  applicationId String  @unique
  fullName     String
  fatherName   String   @default("")
  dateOfBirth  String   @default("")
  gender       String   @default("")
  mobile       String
  email        String
  password     String
  address      String   @default("")
  state        String   @default("")
  district     String   @default("")
  pincode      String   @default("")
  qualification String  @default("")
  course       String
  status       String   @default("submitted")
  emailSent    Boolean  @default(false)
  firstLogin   Boolean  @default(true)
  lastLoginAt  DateTime?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([mobile])
  @@index([email])
  @@index([status])
  @@map("skillstudents")
}

model Student {
  id                    String   @id @default(cuid())
  studentId             String   @unique
  applicationId         String   @default("")
  fullName              String
  fatherName            String   @default("")
  dateOfBirth           String   @default("")
  gender                String   @default("")
  email                 String
  mobile                String   @default("")
  address               String   @default("")
  state                 String   @default("")
  district              String   @default("")
  pincode               String   @default("")
  password              String
  passwordChangedAt     DateTime?
  lastLoginAt           DateTime?

  course                String   @default("Skill Development Programme")
  courseCode            String   @default("AJFT-SDP")

  applicationStatus     String   @default("active")
  enrollmentStatus      String   @default("not_started")
  courseStartedAt       DateTime?
  courseCompletedAt     DateTime?

  courseProgress        Int      @default(0)
  modulesCompleted      Int      @default(0)
  totalModules          Int      @default(0)
  examEligible          Boolean  @default(true)

  examStatus             String  @default("not_started")
  totalQuestions         Int     @default(70)
  totalMarks             Int     @default(70)
  passingMarks           Int     @default(45)
  obtainedMarks          Int     @default(0)
  percentage             Float   @default(0)
  examAttempt            Int     @default(0)
  examStartedAt          DateTime?
  examCompletedAt        DateTime?

  certificateEligible    Boolean  @default(false)
  certificateGenerated   Boolean  @default(false)
  certificateId          String   @default("")
  certificateUrl         String   @default("")
  certificateGeneratedAt DateTime?

  credentialsEmailSent   Boolean  @default(false)
  certificateEmailSent   Boolean  @default(false)

  adminRemarks           String   @default("")
  source                 String   @default("website")

  createdAt              DateTime @default(now())
  updatedAt              DateTime @updatedAt

  @@index([applicationId])
  @@index([email])
  @@index([mobile])
  @@index([applicationStatus, enrollmentStatus])
  @@index([examStatus])
  @@index([certificateEligible])
  @@map("students")
}

model StudentApplication {
  id                    String   @id @default(cuid())
  applicationId         String   @unique
  appliedProgram        String   @default("Skill Development Programme")
  courseName            String   @default("")

  fullName              String
  fatherName            String   @default("")
  motherName            String   @default("")
  dateOfBirth           String   @default("")
  gender                String   @default("")

  mobile                String
  email                 String   @default("")
  address               String   @default("")
  state                 String   @default("")
  district              String   @default("")
  pincode               String   @default("")

  studentId             String   @unique
  password              String
  passwordChangedAt     DateTime?
  lastLoginAt           DateTime?

  status                String   @default("approved")
  enrollmentStatus      String   @default("not_started")
  courseStartedAt       DateTime?
  courseCompletedAt     DateTime?

  examStatus            String   @default("not_started")
  totalQuestions        Int      @default(70)
  passingMarks          Int      @default(45)
  obtainedMarks         Int      @default(0)
  totalMarks            Int      @default(70)
  percentage            Float    @default(0)
  examAttempt           Int      @default(0)
  examStartedAt         DateTime?
  examCompletedAt       DateTime?

  certificateEligible   Boolean  @default(false)
  certificateGenerated  Boolean  @default(false)
  certificateId         String   @default("")
  certificateUrl        String   @default("")
  certificateGeneratedAt DateTime?

  applicationEmailSent  Boolean  @default(false)
  credentialsEmailSent  Boolean  @default(false)
  certificateEmailSent  Boolean  @default(false)

  adminRemarks          String   @default("")
  approvedAt            DateTime?
  rejectedAt            DateTime?
  source                String   @default("website")

  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt

  @@index([mobile])
  @@index([email])
  @@index([status, enrollmentStatus])
  @@index([examStatus])
  @@index([certificateEligible])
  @@map("studentapplications")
}

model StudentExamAttempt {
  id             String   @id @default(cuid())
  studentId      String
  examName       String   @default("Skill Development Final Assessment")
  totalQuestions Int      @default(70)
  passingMarks   Int      @default(45)
  answers        Json?
  score          Float    @default(0)
  percentage     Float    @default(0)
  result         String   @default("pending")
  startedAt      DateTime @default(now())
  submittedAt    DateTime?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@index([studentId])
  @@index([result])
  @@map("studentexamattempts")
}

model TreePlantation {
  id             String   @id @default(cuid())
  plantationId   String   @unique
  participantId  String
  treeName       String
  treeType       String   @default("")
  plantationDate String
  state          String   @default("")
  district       String   @default("")
  address        String   @default("")
  latitude       String   @default("")
  longitude      String   @default("")
  locationName   String   @default("")
  photo          String   @default("")
  beforePhoto    String   @default("")
  afterPhoto     String   @default("")
  status         String   @default("submitted")
  bonusAmount    Float    @default(0)
  adminRemark    String   @default("")
  verifiedAt     DateTime?
  verifiedBy     String   @default("")
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@index([participantId])
  @@index([status])
  @@map("treeplantations")
}

model VisitorEvent {
  id            String   @id @default(cuid())
  visitorId     String
  sessionId     String
  eventName     String
  eventCategory String?
  page          String?
  eventData     Json?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([visitorId])
  @@index([sessionId])
  @@index([eventName])
  @@index([createdAt])
  @@map("visitorevents")
}

model VisitorSession {
  id              String   @id @default(cuid())
  visitorId       String
  sessionId       String   @unique
  landingPage     String?
  exitPage        String?
  referrer        String?
  source          String?
  medium          String?
  country         String?
  region          String?
  deviceType      String?
  browser         String?
  operatingSystem String?
  screenWidth     Int?
  screenHeight    Int?
  pageCount       Int      @default(0)
  startedAt       DateTime @default(now())
  lastSeenAt      DateTime @default(now())
  endedAt         DateTime?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([visitorId])
  @@index([sessionId])
  @@map("visitorsessions")
}